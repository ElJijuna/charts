{
    "name": "@real-native/charts-example",
    "version": "0.0.0",
    "private": true,
    "description": "Expo host for developing and testing @real-native/charts on native platforms",
    "main": "index.ts",
    "scripts": {
        "start": "expo start",
        "android": "expo start --android",
        "ios": "expo start --ios",
        "postinstall": "setup-skia-web public",
        "storybook": "storybook dev --port 6006",
        "storybook:build": "storybook build",
        "web": "expo start --web",
        "test:e2e": "playwright test",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@shopify/react-native-skia": "2.6.2",
        "expo": "~57.0.22",
        "expo-status-bar": "~57.0.1",
        "react": "19.2.3",
        "react-dom": "19.2.3",
        "react-native": "0.86.3",
        "react-native-gesture-handler": "~2.32.0",
        "react-native-reanimated": "4.5.1",
        "react-native-web": "^0.21.2",
        "react-native-worklets": "0.10.1",
        "victory-native": "^42.0.1"
    },
    "devDependencies": {
        "@playwright/test": "^1.63.0",
        "@storybook/react-native-web-vite": "^10.6.0",
        "@types/react": "~19.2.4",
        "babel-preset-expo": "~57.0.0",
        "storybook": "^10.6.0",
        "typescript": "~6.0.3",
        "vite": "^7.3.6",
        "vite-plugin-rnw": "^0.0.12"
    }
}
