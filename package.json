{
  "name": "@real-native/charts",
  "version": "0.0.0",
  "description": "Friendly, customizable charts for React Native powered by Victory Native",
  "main": "./lib/commonjs/index.js",
  "module": "./lib/module/index.js",
  "types": "./lib/typescript/commonjs/index.d.ts",
  "react-native": "./src/index.ts",
  "source": "./src/index.ts",
  "exports": {
    ".": {
      "react-native": "./src/index.ts",
      "import": {
        "types": "./lib/typescript/module/index.d.ts",
        "default": "./lib/module/index.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/index.d.ts",
        "default": "./lib/commonjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "README.md",
    "CHANGELOG.md",
    "!**/__tests__",
    "!**/*.test.ts",
    "!**/*.test.tsx",
    "!**/*.stories.ts",
    "!**/*.stories.tsx",
    "!**/stories"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "bob build",
    "typecheck": "tsc --noEmit && npm --prefix example run typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:md": "markdownlint-cli2 \"**/*.md\" \"!**/node_modules\" \"!**/lib\" \"!CHANGELOG.md\"",
    "format": "biome check --write .",
    "format:check": "biome check .",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "docs": "typedoc",
    "example": "npm --prefix example start",
    "example:android": "npm --prefix example run android",
    "example:ios": "npm --prefix example run ios",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "react-native",
    "expo",
    "charts",
    "data-visualization",
    "victory-native",
    "skia"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ElJijuna/charts.git"
  },
  "bugs": {
    "url": "https://github.com/ElJijuna/charts/issues"
  },
  "homepage": "https://github.com/ElJijuna/charts#readme",
  "author": "pilmee <pilmee@gmail.com> (https://github.com/ElJijuna)",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "peerDependencies": {
    "@shopify/react-native-skia": ">=2.6.0 <3.0.0",
    "react": ">=19.0.0",
    "react-native": ">=0.79.0",
    "react-native-gesture-handler": ">=2.0.0",
    "react-native-reanimated": ">=3.19.1",
    "victory-native": ">=42.0.0 <43.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@biomejs/biome": "^2.4.16",
    "@commitlint/cli": "^19.6.0",
    "@commitlint/config-conventional": "^19.6.0",
    "@react-native/jest-preset": "0.87.1",
    "@react-native/babel-preset": "0.87.1",
    "@react-native/typescript-config": "0.87.1",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@shopify/react-native-skia": "^2.6.0",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.0",
    "@types/react": "^19.3.0",
    "eslint": "^10.0.0",
    "jest": "^29.7.0",
    "markdownlint-cli2": "^0.23.2",
    "react": "19.3.0",
    "react-native": "0.87.1",
    "react-native-builder-bob": "^0.43.0",
    "react-native-gesture-handler": "^2.28.0",
    "react-native-reanimated": "^4.6.0",
    "react-native-worklets": "^0.12.2",
    "semantic-release": "^24.2.0",
    "super-configs": "^1.25.1",
    "typedoc": "^0.28.0",
    "typescript": "^5.9.0",
    "victory-native": "^42.0.1"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "commonjs",
        {
          "esm": true
        }
      ],
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ],
    "exclude": "{**/{__tests__,__fixtures__,__mocks__,stories}/**,**/*.{spec,test,stories}.{ts,tsx}}"
  }
}
